# ===== vibecoding monorepo 根 .gitignore =====
# 覆盖仓库根目录的构建/IDE 产物（各子项目另有自己的 .gitignore）

# 依赖（任意层级）
node_modules/

# 构建产物
dist/
dist_h5/
.taro/
.npm/
.rn_temp/

# IDE / AI 工具链
.pai/
.trae/
.cursor/
.vscode/
.idea/
.swc/

# 操作系统
.DS_Store
Thumbs.db

# 日志
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 缓存
.cache/
.parcel-cache/
.eslintcache

# 运行时数据库
*.db
*.sqlite
*.sqlite3

# 测试覆盖
coverage/
